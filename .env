# Public port the bundler HTTP service listens on
BUNDLER_PORT=8080

# Comma-separated list of allowed client IPs for POST /bundle.
# Use "*" to allow any IP. Behind a reverse proxy, the proxy's IP is what
# matters unless --proxy-headers + a trusted X-Forwarded-For chain are set up.
BUNDLER_ALLOWED_IPS=*

# How many builds may run in parallel. Rust builds are heavy; keep at 1 on
# a small VPS unless you have plenty of RAM/CPU.
BUNDLER_MAX_CONCURRENT=1
