# Public port the bundler HTTP service listens on
BUNDLER_PORT=8080

# Shared secret. Clients must POST this exact string as a `token` form field
# alongside the config zip on /bundle, or the job is rejected with 401.
# Generate one with: openssl rand -hex 32
# The service refuses to start with an empty BUNDLER_TOKEN.
BUNDLER_TOKEN=

# How many builds may run in parallel. Rust builds are heavy; keep at 1 on
# a small VPS unless you have plenty of RAM/CPU.
BUNDLER_MAX_CONCURRENT=1
